import("//build/config/features.gni")
import("//build/test.gni")
import(
    "//foundation/distributedhardware/distributed_input/distributedinput.gni")

ohos_fuzztest("InputNodeListenerStubFuzzTest") {
  module_out_path = fuzz_test_path

  fuzz_config_file = "${distributedinput_path}/test/fuzztest/inputnodelistenerstub_fuzzer"

  include_dirs = [
    "${common_path}/include",
    "${frameworks_path}/include",
    "${ipc_path}/include",
    "${distributedinput_path}/test/fuzztest/common",
    "${utils_path}/include",
  ]

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]

  sources = [
    "${ipc_path}/src/input_node_listener_stub.cpp",
    "input_node_listener_stub_fuzzer.cpp",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
  ]

  defines = [
    "HI_LOG_ENABLE",
    "DH_LOG_TAG=\"InputNodeListenerStubFuzzTest\"",
    "LOG_DOMAIN=0xD004120",
  ]
}

group("fuzztest") {
  testonly = true

  deps = [ ":InputNodeListenerStubFuzzTest" ]
}
